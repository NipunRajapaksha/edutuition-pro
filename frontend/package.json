  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs=require('fs'); try{fs.cpSync('dist', '../dist', {recursive:true});}catch(e){}\"",
    "build:vercel": "vite build && node -e \"const fs=require('fs'); try{fs.cpSync('dist', '../dist', {recursive:true});}catch(e){}\"",

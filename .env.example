# EduTuition Pro - Production Environment Variables

# Server Port (Render sets this automatically to 10000)
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=tuition_management_production_secret_key_2025

# Optional: Remote MongoDB Connection (e.g. MongoDB Atlas Free Cluster)
# If not specified, the system will use the embedded zero-config persistent storage!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edutuition?retryWrites=true&w=majority

# Optional: Frontend API URL (Only needed if deploying Frontend on Vercel separately)
# VITE_API_BASE_URL=https://your-backend-app.onrender.com/api

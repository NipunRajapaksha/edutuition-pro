# Server Configuration
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_production_jwt_key_change_this_2025

# Database Configuration (Optional)
# If provided, the app connects to MongoDB (e.g. MongoDB Atlas cluster).
# If left commented or empty, it automatically uses the built-in persistent datastore!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/edutuition?retryWrites=true&w=majority
